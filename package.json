{
  "name": "dynamic-agent-harness",
  "version": "0.1.0",
  "description": "Build a durable, governed, vendor-neutral dynamic agent harness for your organization.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ZaltaClaw/dynamic-agent-harness.git"
  },
  "bugs": {
    "url": "https://github.com/ZaltaClaw/dynamic-agent-harness/issues"
  },
  "homepage": "https://github.com/ZaltaClaw/dynamic-agent-harness#readme",
  "keywords": ["agents", "agent-harness", "long-running-agents", "nextjs", "human-in-the-loop"],
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 -p 3110",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 -p 3110",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.7",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
