# Specs never contain credentials. A future live model adapter reads secrets server-side.
# HARNESS_MODEL_BASE_URL=https://api.openai.com/v1
# HARNESS_MODEL_API_KEY=
# HARNESS_MODEL_ID=

# Trusted server configuration only. Never derive this path from a request or model output.
# Override the local data root when needed.
# HARNESS_DATA_ROOT=.data
